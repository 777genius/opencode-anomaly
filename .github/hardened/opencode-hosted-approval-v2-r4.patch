+        "decision",
+        "outcome",
+        "permissionDigest",
+        "requestId",
+        "requestIncarnation",
+        "runtimeInstanceId",
+        "sessionId",
+        "sessionIncarnation",
+      ],
+      "producer-provenance-native-effect",
+    )
