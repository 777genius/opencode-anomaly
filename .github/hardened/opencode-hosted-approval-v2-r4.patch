+    `${openCodeTimeline.device}:${openCodeTimeline.inode}` ===
+    `${protectedEffectLedger.device}:${protectedEffectLedger.inode}`
+  ) {
+    throw new TypeError("producer-provenance-descriptor-alias")
+  }
