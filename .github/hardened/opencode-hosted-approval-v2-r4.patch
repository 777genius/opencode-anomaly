+    if (
+      current.started !== gate.started ||
+      current.executable !== gate.executable ||
+      current.group !== gate.group ||
+      current.group !== gate.pid
+    ) {
+      recordError(errors, `portable gate PID ${gate.pid} identity changed before ${signal}`, undefined)
+      return
+    }
