+      filesystem: {
+        exists: (file) => (file.endsWith(".ack") ? false : existsSync(file)),
+        read: (file) => readFileSync(file, "utf8"),
+        write: writeFileSync,
+        unlink: unlinkSync,
+      },
+      onControls: (files) => {
+        controls = files
