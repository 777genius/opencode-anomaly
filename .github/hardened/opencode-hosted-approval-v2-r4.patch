+
+async function stopCommandChild(
+  child: Pick<ReturnType<typeof Bun.spawn>, "pid" | "kill">,
+  abort: string,
+  acknowledgement: string,
+  deadline: number,
+  filesystem: Pick<CommandFilesystem, "exists" | "write"> = { exists: existsSync, write: writeFileSync },
