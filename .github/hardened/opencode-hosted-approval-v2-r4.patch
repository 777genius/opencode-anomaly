diff --git a/packages/opencode/test/server/httpapi-hosted-approval.test.ts b/packages/opencode/test/server/httpapi-hosted-approval.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..67d5e7768122ec9c463ea6919793a486ad00bc66
