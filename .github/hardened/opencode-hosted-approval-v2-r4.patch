+        startTicks,
+        exeDevice: executable.device,
+        exeInode: executable.inode,
+        exeSha256: executable.sha256,
+        moduleDevice: module.device,
+        moduleInode: module.inode,
+        moduleSha256: module.sha256,
+      }
+    },
+    deriveCompiledIdentity: (modulePath) =>
