{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/777genius/opencode-anomaly/blob/dev/.github/hardened/release-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "workflow", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": {
      "type": "object",
      "required": [
        "sourceCommit",
        "sourceTree",
        "artifactTree",
        "baseCommit",
        "patchSha256",
        "patchSize",
        "version",
        "tag",
        "bunVersion",
        "productionEligible"
      ],
      "properties": {
        "sourceCommit": { "const": "129f9fa33e64db936750e0acaf027c704b223de0" },
        "sourceTree": { "const": "852bf48f30c9ba6e6048438a7831472ed2d566b4" },
        "artifactTree": { "const": "03d558efcf3af7a6fbc1de9d06b1465d1cb4693f" },
        "baseCommit": { "const": "ef2880f379129aa048be9e9353e30aa168d42c17" },
        "patchSha256": { "const": "01741dcaeac2dd141a1c2fff7192f5f9b76307bf8d0342b902c1b2bdca90d3a4" },
        "patchSize": { "const": 98404 },
        "version": { "const": "1.18.23-agentteams.1" },
        "tag": { "const": "v1.18.23-agentteams.1" },
        "bunVersion": { "const": "1.3.14" },
        "productionEligible": { "const": false }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "runId", "runAttempt", "actor", "ref", "sha"],
      "properties": {
        "repository": { "type": "string" },
        "workflow": { "type": "string" },
        "runId": { "type": "string" },
        "runAttempt": { "type": "string" },
        "actor": { "type": "string" },
        "ref": { "type": "string" },
        "sha": { "type": "string" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "archive": { "type": "string" },
          "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "archiveSize": { "type": "integer", "exclusiveMinimum": 0 },
          "binaryPath": { "enum": ["opencode", "opencode.exe"] },
          "binarySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "binarySize": { "type": "integer", "exclusiveMinimum": 0 },
          "platform": { "type": "string" },
          "os": { "enum": ["linux", "darwin", "windows"] },
          "arch": { "enum": ["x64", "arm64"] },
          "signing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["binaryStatus", "reason", "provenanceAction", "provenanceStatus"],
            "properties": {
              "binaryStatus": { "const": "unsigned" },
              "reason": { "const": "non-production fork prerelease" },
              "provenanceAction": {
                "const": "actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8"
              },
              "provenanceStatus": { "const": "required-after-manifest" }
            }
          }
        },
        "required": [
          "archive",
          "archiveSha256",
          "archiveSize",
          "binaryPath",
          "binarySha256",
          "binarySize",
          "platform",
          "os",
          "arch",
          "signing"
        ]
      }
    }
  }
}
