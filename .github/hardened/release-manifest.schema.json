{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/777genius/opencode-anomaly/blob/dev/.github/hardened/release-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "workflow", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": {
      "type": "object",
      "required": [
        "sourceCommit",
        "sourceTree",
        "artifactTree",
        "baseCommit",
        "patchSha256",
        "patchSize",
        "version",
        "tag",
        "bunVersion",
        "productionEligible"
      ],
      "properties": {
        "sourceCommit": { "const": "044bb4a47b6c2e4cecfb7d790f6be5f5efe3a0b1" },
        "sourceTree": { "const": "4873a6eda63b8a78d6cd4badb70c3a3a5532bfc6" },
        "artifactTree": { "const": "6b0442241c0fe40c6711352952766602b1904f97" },
        "baseCommit": { "const": "47b6b6f5f4f9b42d2bce7af1c4e5bf6efaf22ba7" },
        "patchSha256": { "const": "da46d1d5b59297ce60dbf7be15fdbbee201460a3c9f52a9a081cbffe32482cb8" },
        "patchSize": { "const": 90137 },
        "version": { "const": "1.18.22-agentteams.1" },
        "tag": { "const": "v1.18.22-agentteams.1" },
        "bunVersion": { "const": "1.3.14" },
        "productionEligible": { "const": false }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "runId", "runAttempt", "actor", "ref", "sha"],
      "properties": {
        "repository": { "type": "string" },
        "workflow": { "type": "string" },
        "runId": { "type": "string" },
        "runAttempt": { "type": "string" },
        "actor": { "type": "string" },
        "ref": { "type": "string" },
        "sha": { "type": "string" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "archive": { "type": "string" },
          "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "archiveSize": { "type": "integer", "exclusiveMinimum": 0 },
          "binaryPath": { "enum": ["opencode", "opencode.exe"] },
          "binarySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "binarySize": { "type": "integer", "exclusiveMinimum": 0 },
          "platform": { "type": "string" },
          "os": { "enum": ["linux", "darwin", "windows"] },
          "arch": { "enum": ["x64", "arm64"] },
          "signing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["binaryStatus", "reason", "provenanceAction", "provenanceStatus"],
            "properties": {
              "binaryStatus": { "const": "unsigned" },
              "reason": { "const": "non-production fork prerelease" },
              "provenanceAction": {
                "const": "actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8"
              },
              "provenanceStatus": { "const": "required-after-manifest" }
            }
          }
        },
        "required": [
          "archive",
          "archiveSha256",
          "archiveSize",
          "binaryPath",
          "binarySha256",
          "binarySize",
          "platform",
          "os",
          "arch",
          "signing"
        ]
      }
    }
  }
}
