{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/777genius/opencode-anomaly/blob/dev/.github/hardened/release-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "workflow", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": {
      "type": "object",
      "required": [
        "sourceCommit",
        "sourceTree",
        "baseCommit",
        "patchSha256",
        "patchSize",
        "version",
        "tag",
        "bunVersion",
        "productionEligible"
      ],
      "properties": {
        "sourceCommit": { "const": "94540b2cbd116bb5bcd6c9ac8f4734f3df637a2b" },
        "sourceTree": { "const": "762a2f4322b572639b12f2ec30a126de72138d18" },
        "baseCommit": { "const": "826d9ad46a22bef0294998e08daa3c4904fea28f" },
        "patchSha256": { "const": "c8a1389e6e296e25d5cb7f9da563d09c5d87560ea2ca1a0aab0d6dc1c9a11968" },
        "patchSize": { "const": 85072 },
        "version": { "const": "1.18.21-agentteams.1" },
        "tag": { "const": "v1.18.21-agentteams.1" },
        "bunVersion": { "const": "1.3.14" },
        "productionEligible": { "const": false }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "runId", "runAttempt", "actor", "ref", "sha"],
      "properties": {
        "repository": { "type": "string" },
        "workflow": { "type": "string" },
        "runId": { "type": "string" },
        "runAttempt": { "type": "string" },
        "actor": { "type": "string" },
        "ref": { "type": "string" },
        "sha": { "type": "string" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "archive": { "type": "string" },
          "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "archiveSize": { "type": "integer", "exclusiveMinimum": 0 },
          "binaryPath": { "enum": ["opencode", "opencode.exe"] },
          "binarySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "binarySize": { "type": "integer", "exclusiveMinimum": 0 },
          "platform": { "type": "string" },
          "os": { "enum": ["linux", "darwin", "windows"] },
          "arch": { "enum": ["x64", "arm64"] },
          "signing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["binaryStatus", "reason", "provenanceAction", "provenanceStatus"],
            "properties": {
              "binaryStatus": { "const": "unsigned" },
              "reason": { "const": "non-production fork prerelease" },
              "provenanceAction": {
                "const": "actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8"
              },
              "provenanceStatus": { "const": "required-after-manifest" }
            }
          }
        },
        "required": [
          "archive",
          "archiveSha256",
          "archiveSize",
          "binaryPath",
          "binarySha256",
          "binarySize",
          "platform",
          "os",
          "arch",
          "signing"
        ]
      }
    }
  }
}
