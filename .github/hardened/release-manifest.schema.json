{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/777genius/opencode-anomaly/blob/dev/.github/hardened/release-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "workflow", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": {
      "type": "object",
      "required": [
        "sourceCommit",
        "sourceTree",
        "artifactTree",
        "baseCommit",
        "patchSha256",
        "patchSize",
        "version",
        "tag",
        "bunVersion",
        "productionEligible"
      ],
      "properties": {
        "sourceCommit": { "const": "cee24c1de70a220253c115822d8846b973b9e5a4" },
        "sourceTree": { "const": "970e7191f1751dbc591333209607a8cc422b3204" },
        "artifactTree": { "const": "c28c1abe9e5711579ee07be6ea00c4e4323f0faf" },
        "baseCommit": { "const": "ef2880f379129aa048be9e9353e30aa168d42c17" },
        "patchSha256": { "const": "ebd5d063ee774a17f5f4aa64277a9d2b48d8648719b62e2f8ca6da569d49e30c" },
        "patchSize": { "const": 190241 },
        "version": { "const": "1.18.23-agentteams.1" },
        "tag": { "const": "v1.18.23-agentteams.1" },
        "bunVersion": { "const": "1.4.0" },
        "productionEligible": { "const": false }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "runId", "runAttempt", "actor", "ref", "sha"],
      "properties": {
        "repository": { "type": "string" },
        "workflow": { "type": "string" },
        "runId": { "type": "string" },
        "runAttempt": { "type": "string" },
        "actor": { "type": "string" },
        "ref": { "type": "string" },
        "sha": { "type": "string" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "archive": { "type": "string" },
          "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "archiveSize": { "type": "integer", "exclusiveMinimum": 0 },
          "binaryPath": { "enum": ["opencode", "opencode.exe"] },
          "binarySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "binarySize": { "type": "integer", "exclusiveMinimum": 0 },
          "platform": { "type": "string" },
          "os": { "enum": ["linux", "darwin", "windows"] },
          "arch": { "enum": ["x64", "arm64"] },
          "signing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["binaryStatus", "reason", "provenanceAction", "provenanceStatus"],
            "properties": {
              "binaryStatus": { "const": "unsigned" },
              "reason": { "const": "non-production fork prerelease" },
              "provenanceAction": {
                "const": "actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8"
              },
              "provenanceStatus": { "const": "required-after-manifest" }
            }
          }
        },
        "required": [
          "archive",
          "archiveSha256",
          "archiveSize",
          "binaryPath",
          "binarySha256",
          "binarySize",
          "platform",
          "os",
          "arch",
          "signing"
        ]
      }
    }
  }
}
